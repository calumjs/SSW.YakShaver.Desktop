# ============================================================
# YakShaver Video Backend - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# Server
PORT=3001
NODE_ENV=development

# ============================================================
# LLM Provider (choose one: "openai", "azure", or "claude")
# ============================================================
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Azure OpenAI ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Claude (Anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ============================================================
# Transcription Provider ("openai-whisper" or "azure-whisper")
# ============================================================
TRANSCRIPTION_PROVIDER=openai-whisper
WHISPER_MODEL=whisper-1

# ============================================================
# S3-compatible Storage
# ============================================================
# For MinIO (local dev via docker-compose):
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=yakshaver-videos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1

# For AWS S3:
# S3_BUCKET=your-bucket-name
# S3_REGION=ap-southeast-2
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false

# For Azure Blob (via S3-compatible gateway):
# S3_ENDPOINT=https://<account>.blob.core.windows.net
# S3_BUCKET=yakshaver-videos
# S3_ACCESS_KEY_ID=<account-name>
# S3_SECRET_ACCESS_KEY=<account-key>

# ============================================================
# Azure Service Bus (Job Queue)
# ============================================================
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...
AZURE_SERVICE_BUS_QUEUE_NAME=video-processing

# ============================================================
# Portal (SSW.YakShaver API) - Optional
# ============================================================
# If not set, a mock portal client is used.
# PORTAL_BASE_URL=https://yakshaver.ssw.com.au
# PORTAL_API_KEY=

# ============================================================
# MCP Servers (Default, JSON array) - Optional
# ============================================================
# These are used when no project-specific MCP servers are configured.
# MCP_SERVERS=[{"name":"github","transport":"streamableHttp","url":"https://mcp.github.com/sse","headers":{"Authorization":"Bearer ghp_..."}}]

# ============================================================
# Authentication (Layer 1: who can use YakShaver)
# ============================================================
# Simple API key auth (for bootstrapping / service-to-service)
YAKSHAVER_API_KEY=your-secret-api-key
YAKSHAVER_API_KEY_USER_ID=admin
YAKSHAVER_API_KEY_USER_NAME=Admin User

# For JWT auth, configure your IdP settings:
# JWT_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# JWT_AUDIENCE=api://yakshaver-backend

# ============================================================
# Agent Configuration
# ============================================================
# Extended thinking budget in tokens (Claude only, 0 = disabled)
THINKING_BUDGET=10000
# Maximum agentic turns (each turn = one LLM call + tool execution)
MAX_AGENT_TURNS=50

# ============================================================
# Upload Limits
# ============================================================
MAX_FILE_SIZE_MB=500
